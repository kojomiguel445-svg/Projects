{
 "setup": {
  "state": {}
 },
 "steps": [
  {
   "name": "add",
   "eval": "(()=>{const st=E.state;for(const [n,c,s] of [['Lia','mago','elfo'],['Bram','clerigo','anao'],['Kai','ladino','pequenino']]){const h=E.C.create({name:n,cls:c,species:s,background:'soldado',base:{for:12,des:14,con:13,int:15,sab:12,car:10},bgBonus:{int:2,con:1},skills:[]});st.heroes.push(h);}E.Store.save();E.HUD.update();return {party:E.Party.ids().length,names:E.Party.list().map(h=>h.name)};})()",
   "shot": "party-p1-hud",
   "settle": 800
  },
  {
   "name": "switch",
   "eval": "(()=>{window.__t=performance.now();E.HUD.switchHero(E.Party.list()[1].id);return E.Store.hero().name;})()",
   "shot": "party-p2-mid",
   "settle": 150
  },
  {
   "name": "after",
   "eval": "(()=>({active:E.Store.hero().name,cd:document.querySelector('#hud .party').className,op:E.WG.world.heroSprite.material.opacity}))()",
   "shot": "party-p3-after",
   "settle": 1400
  },
  {
   "name": "party",
   "eval": "(()=>{E.PartyUI.open();return document.querySelectorAll('.pts-slot').length;})()",
   "shot": "party-p4-party",
   "settle": 600
  },
  {
   "name": "put",
   "eval": "(()=>{document.querySelector('[data-slot=\"2\"]').click();const kai=E.state.heroes.find(h=>h.name==='Kai');document.querySelector('[data-hero=\"'+kai.id+'\"]').click();return E.Party.list().map(h=>h.name);})()",
   "shot": "party-p5-party2",
   "settle": 400
  },
  {
   "name": "close",
   "eval": "(()=>{E.UI.closeAll();return E.Party.list().map(h=>h.name);})()",
   "shot": "party-p6-hud2",
   "settle": 700
  },
  {
   "name": "battle",
   "eval": "(()=>{E.BattleUI.start(['lobo','lobo'],{noCoop:true});return 1;})()",
   "wait": 4500,
   "shot": "party-b1-start",
   "settle": 500
  },
  {
   "name": "info",
   "eval": "(()=>{const b=E.BattleUI.current;return {allies:b.allies.map(a=>a.name+' '+a.hp+'/'+a.maxHp+' local:'+a.local),order:(b.order||[]).map(o=>b.nameOf(o)+':'+o.init)};})()"
  },
  {
   "name": "drive",
   "eval": "(()=>{window.__log=[];window.__pausedAlly=false;window.__drv=setInterval(()=>{const res=document.querySelector('.result button');if(res){window.__res=document.querySelector('.result').innerText;res.click();clearInterval(window.__drv);return;}const ally=document.querySelector('.ally-cmd .act.main');if(ally&&!ally.disabled){if(!window.__pausedAlly){window.__pausedAlly=true;window.__hold=true;return;}if(window.__hold)return;window.__log.push('ally');ally.click();return;}const main=document.querySelector('.cmd .cmd-tabs')&&document.querySelector('.cmd .act.main');if(main&&!main.disabled){window.__log.push('hero');main.click();return;}const end=document.querySelector('.cmd .act.end');if(end&&!end.disabled&&document.querySelector('.cmd .cmd-tabs')){window.__log.push('end');end.click();}const dr=document.querySelector('.dr-btn');if(dr)dr.click();},400);return 1;})()",
   "wait": 100
  },
  {
   "name": "waitAlly",
   "eval": "(async()=>{for(let i=0;i<120&&!window.__hold;i++)await new Promise(r=>setTimeout(r,250));return {hold:!!window.__hold,log:window.__log};})()",
   "shot": "party-b2-ally",
   "settle": 300
  },
  {
   "name": "resume",
   "eval": "(()=>{window.__hold=false;return 1;})()"
  },
  {
   "name": "waitEnd",
   "eval": "(async()=>{for(let i=0;i<360&&!window.__res;i++)await new Promise(r=>setTimeout(r,250));return {res:(window.__res||'').replace(/\\s+/g,' ').slice(0,300),log:window.__log.join(',')};})()"
  },
  {
   "name": "after",
   "eval": "(()=>E.state.heroes.map(h=>({n:h.name,hp:h.hp+'/'+E.C.maxHp(h),xp:h.xp,pot:(h.inventory||{}).pocao_cura})))()",
   "shot": "party-b3-after",
   "settle": 800
  },
  {
   "name": "hire",
   "eval": "(()=>{E.UI.closeAll();const h=E.Store.hero(),r=E.Settlements.region();const id=Object.keys(E.Settlements.JOBS)[0];const j=E.Settlements.jobData(h,r);j.contract=id;E.Work.card(h).hired={job:id,region:E.Settlements.region(r),day:1};E.Store.save();E.Work.openCard();return id;})()",
   "shot": "party-c4-card",
   "settle": 600
  },
  {
   "name": "confirm",
   "eval": "(()=>{const b=[...document.querySelectorAll('.world-service-panel button')].find(x=>/Pedir demiss/.test(x.textContent));b.click();return document.querySelector('.world-service-panel').innerText.slice(0,300);})()",
   "shot": "party-c5-confirm",
   "settle": 500
  },
  {
   "name": "resign",
   "eval": "(()=>{const b=[...document.querySelectorAll('.world-service-panel button')].find(x=>/Confirmar demiss/.test(x.textContent));b.click();const h=E.Store.hero();return {txt:document.querySelector('.world-service-panel').innerText.slice(0,260),cur:E.Work.current(h),hist:E.Work.card(h).history.map(x=>x.reason)};})()",
   "shot": "party-c6-done",
   "settle": 500
  }
 ]
}