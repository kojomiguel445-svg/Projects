   "name": "setup",
   "eval": "(()=>{const h=E.Store.hero(),r=E.Settlements.region(),d=E.Settlements.data(h);d.jobs[r]={contract:'clerk',interviewDay:0,lastShiftDay:0,shifts:0};E.Work.normalize(h);\nwindow.__serve=(wrong)=>{const c=E.Interior.current,s=E.Work.shift();if(!c||!c.panel||!s)return 'no-shift';const q=k=>c.panel.querySelector(k),cu=s.at>=0?s.customers[s.at]:null;if(!cu||cu.state==='done'){const f=q('[data-act=finish]');if(f&&!f.hidden){f.click();return 'finished';}return 'waiting '+s.served+' people='+c.people.map(p=>p.state).join(',');}\nif(cu.state==='scan'){cu.lines.forEach((l,li)=>{let n=0;while(l.scanned<l.qty&&n++<4){const x=c.panel.querySelector('[data-scan=\"'+li+'\"]');if(!x||x.disabled)break;x.click();}});q('[data-act=bill]').click();return 'billed '+cu.total;}\nif(cu.state==='pay'){q('[data-act=receive]').click();return 'received '+cu.paid;}\nif(cu.state==='change'){const w=window.__wrongOnce;window.__wrongOnce=false;let due=cu.paid-cu.total;if(w)due+=due>0?-1:1;for(const co of E.Work.COINS){while(due>=co.v&&s.drawer[co.id]>0){const b=c.panel.querySelector('[data-coin='+co.id+']');if(!b)break;b.click();due-=co.v;}}q('[data-act=give]').click();return 'gave tray left='+due+' state='+cu.state;}\nreturn cu.state;};return d.jobs[r];})()"
